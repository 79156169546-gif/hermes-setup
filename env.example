# Шаблон ~/.hermes/.env — скопируйте и заполните.
# Путь: hermes config env-path
# Этот файл НЕ коммитится.

# ── Обязательные ──────────────────────────────────────────────────────────

# Ключ OpenRouter — основной провайдер и модель.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Тот же ключ для судьи effortless-hermes.
EFFORTLESS_HERMES_CUSTOM_API_KEY=

# Ключ сервиса памяти Hindsight.
# https://hindsight.vectorize.io
HINDSIGHT_API_KEY=

# ── MCP: Telegram (необязательно) ──────────────────────────────────────────

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# ID чата для уведомлений.
TELEGRAM_CHAT_ID=

# ── Необязательные ────────────────────────────────────────────────────────

# GitHub-токен: публикация скиллов, снятие rate limit.
GITHUB_TOKEN=

# Облачный браузер вместо локального профиля Edge.
BROWSERBASE_API_KEY=

# Внешний STT вместо локального whisper.
OPENAI_API_KEY=

# Генерация изображений.
FAL_KEY=

# TTS вместо бесплатного Edge-TTS.
ELEVENLABS_API_KEY=
